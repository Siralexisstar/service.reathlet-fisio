# Examples only. Keep real values in the ignored .env.local file.
# Server-only configuration: never prefix these variables with VITE_.
RESEND_API_KEY=replace_with_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TO_EMAIL=test-inbox@example.com
# Full form (clinical data + selected signature). Disabled by default.
# Only exact true enables sending, in local and production environments alike.
# Review privacy, content encryption and provider contracts before real health data.
RESEND_FULL_FORM_ENABLED=false
